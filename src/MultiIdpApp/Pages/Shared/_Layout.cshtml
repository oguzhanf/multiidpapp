<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | MultiIdpApp</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="shell" aria-label="Main navigation">
            <a class="brand" asp-page="/Index">MultiIdpApp</a>
            <div class="nav-actions">
                <a asp-page="/Index">Home</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Profile">Session</a>
                    <form asp-page="/SignOut" method="post">
                        <button class="quiet" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="button" asp-page="/SignIn">Sign in</a>
                }
            </div>
        </nav>
    </header>
    <main class="shell">
        @RenderBody()
    </main>
    <footer class="shell">Generic identity-integration sample. Not a production entitlement system.</footer>
</body>
</html>
